# For Expo Web in browser on your laptop
# EXPO_PUBLIC_API_URL=http://localhost:5004

# For Android Studio emulator (recommended for local backend)
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5004
# EXPO_PUBLIC_ANDROID_EMULATOR_LOOPBACK=true

# For Expo Go on your phone (same Wi-Fi as laptop)
# EXPO_PUBLIC_API_URL=http://YOUR_LAPTOP_LAN_IP:5004
# EXPO_PUBLIC_ANDROID_EMULATOR_LOOPBACK=false

# IMPORTANT: do not add /api at the end.
EXPO_PUBLIC_API_URL=http://localhost:5004
